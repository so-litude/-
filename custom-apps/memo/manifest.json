{
  "sdkVersion": "1.0",
  "id": "memo.demo",
  "name": "备忘录",
  "version": "1.0.1",
  "description": "私人记事 + AI 角色可感知、可互动。支持角色留言、角色代笔、角色回复（仅限用户备忘录）、好奇机制、主动请求。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "characters.relations.read",
    "user.profile.read",
    "ai.generate",
    "chat.sendCard",
    "chat.requestReply",
    "chat.read",
    "chat.read.background",
    "chat.tools",
    "chat.write",
    "ui.toast",
    "memory.write"
  ],
  "resources": {
    "presets": ["presets.json"]
  },
  "extensions": {
    "events": [
      {
        "event": "chat.message.created",
        "entry": "events",
        "background": true,
        "description": "监听聊天新消息，识别角色代笔/留言/回复请求与分享卡片（支持后台运行）。"
      }
    ]
  }
}
